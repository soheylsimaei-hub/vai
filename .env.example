# VAI Learning Management System (LMS) — student login endpoint.
# Update PUBLIC_LMS_URL with the final URL confirmed by the IT team
# (Omer / Faisal) before public launch.
PUBLIC_LMS_URL=https://learn.vai.vet/login

# Set to "true" once the LMS is publicly reachable. When "false" the
# Login button is not rendered anywhere on the site.
PUBLIC_LMS_ENABLED=false

# VAI Pulse (build-time only, never embedded in the site). The build takes a PubMed snapshot through the official NCBI E-utilities.
# No account or key is required. NCBI asks for a contact address so it can reach the developer before blocking misbehaving traffic:
# set a VAI OPERATIONAL mailbox (not a personal address). In GitHub: Settings > Variables > VAI_PUBMED_CONTACT_EMAIL.
VAI_PUBMED_CONTACT_EMAIL=
# Optional NCBI API key (raises NCBI's limit from 3 to 10 requests/second; not needed). In GitHub: Settings > Secrets > NCBI_API_KEY.
NCBI_API_KEY=


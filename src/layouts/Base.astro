---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  isHome?: boolean;
  noindex?: boolean;
}
const {
  title,
  description = 'VAI is the professional capability platform for veterinarians — built to strengthen how they reason through real cases, rehearse difficult conversations, and keep developing their professional judgement.',
  ogTitle,
  ogDescription,
  isHome = false,
  noindex = false,
} = Astro.props;
const fullTitle = title.includes('VAI') ? title : `${title} · VAI`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

// Site-wide Organization schema. The home page extends it with founder detail —
// no parentOrganization: VAI is the master brand, not a faculty of another institution.
//
// Phase 4A.8 — corrected stale identity fields ahead of production launch:
// logo now points at the current official lockup (public/vai-veterinary-
// lockup.png), not the pre-redesign root logo. Instagram removed from
// sameAs: the only handle on file (veterinaryacademyinternational) is the
// old "Veterinary Academy International" account, already deliberately
// excluded from the redesigned Footer for the same reason — no current,
// verified VAI Instagram account exists to link instead, so the entry is
// dropped rather than guessed. LinkedIn is unaffected (verified, already
// used consistently in Nav/Footer/SocialLinks). description default
// replaced with the already-approved current homepage positioning
// (verbatim from src/pages/index.astro) instead of the old Academy-era
// "professional home for veterinary careers... specialist calibration..."
// phrasing, which predates this redesign entirely.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'VAI',
  url: 'https://www.vai.vet',
  logo: 'https://www.vai.vet/vai-veterinary-lockup.png',
  description,
  sameAs: [
    'https://www.linkedin.com/company/112349450/',
  ],
};

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'VAI',
  url: 'https://www.vai.vet',
  logo: 'https://www.vai.vet/vai-veterinary-lockup.png',
  description: 'VAI is the professional capability platform for veterinarians — built to strengthen how they reason through real cases, rehearse difficult conversations, and keep developing their professional judgement.',
  founder: {
    '@type': 'Person',
    name: 'Dr. Soheyl Simaei',
    jobTitle: 'Founder & CEO',
  },
  sameAs: [
    'https://www.linkedin.com/company/112349450/',
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Favicons */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0E1B33" />

    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:site_name" content="VAI" />
    <meta property="og:title" content={ogTitle ?? fullTitle} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://www.vai.vet/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="VAI — the professional home for veterinary careers" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? fullTitle} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content="https://www.vai.vet/og-image.jpg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(isHome ? homeSchema : orgSchema)} />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import ContactForm from '../components/ContactForm.astro';

// The two public contact addresses (2026-10-12): vai@vai.vet is VAI's primary address (general, professional, faculty, partnership, programme, Exchange and organisation enquiries) and support@vai.vet is the
// dedicated support address (account, access, technical or platform problems). Both are live. The former faculty address was deleted and must not appear anywhere on the site. These are the ONLY addresses shown here.
//
// FORM_LIVE: the contact form (ContactForm.astro) is built and wired to the VAI app's delivery endpoint, but it stays switched OFF. Before it is switched on, that endpoint (src/app/api/public-contact in
// vai-app) must be checked end to end with a test enquiry delivered to vai@vai.vet, and its old "Faculty Collaboration" route to the deleted faculty mailbox must be removed there (the form here no longer offers it).
const FORM_LIVE = false;
const channels = [
  {
    t: 'General & Professional Enquiries',
    e: 'vai@vai.vet',
    d: 'For questions about VAI, professional collaboration, faculty, partnerships, programmes, VAI Exchange, organisations and other general enquiries.',
  },
  {
    t: 'Support',
    e: 'support@vai.vet',
    d: 'For account, access, technical or platform support.',
  },
];
---
<Base
  title="Contact VAI"
  description="Contact VAI: general and professional enquiries, faculty and academic collaboration, partnerships with organisations, and support for the VAI platform."
>
  <PageHero
    eyebrow="Contact VAI"
    title="Let’s Start a Conversation"
    lede="Whether you’re exploring VAI, interested in professional education, or considering contributing your expertise, we’d be pleased to hear from you."
  />

  {FORM_LIVE && (
    <Section eyebrow="Send an Enquiry" title="Use the form below, or write to us directly.">
      <ContactForm />
    </Section>
  )}

  <Section eyebrow="Write to Us" title={FORM_LIVE ? 'Two ways to reach VAI.' : 'Write to VAI directly.'} tone={FORM_LIVE ? 'ivory' : undefined}>
    {!FORM_LIVE && (
      <p class="max-w-3xl mb-8 text-graphite leading-relaxed">Please write to us at the address that fits your enquiry.</p>
    )}
    <ul class="max-w-5xl border-t border-platinum">
      {channels.map((p) => (
        <li class="grid md:grid-cols-12 gap-6 md:gap-10 items-baseline py-8 border-b border-platinum">
          <div class="md:col-span-4">
            <div class="eyebrow">{p.t}</div>
          </div>
          <div class="md:col-span-8 text-graphite leading-relaxed text-[15px]">
            {p.d}
            <a href={`mailto:${p.e}`} class="block mt-3 text-navy-deep hover:text-champagne transition-colors">{p.e}</a>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section eyebrow="About VAI">
    <div class="prose-editorial max-w-5xl">
      <p>VAI is a veterinary professional development platform and educational ecosystem operated by <strong class="text-navy-deep font-medium">Solex Education Unipessoal Lda</strong>, a company registered in Portugal.</p>
    </div>
  </Section>
</Base>

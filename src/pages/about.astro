---
import Base from '../layouts/Base.astro';
import SignatureGeometry from '../components/texture/SignatureGeometry.astro';
import ReasoningLines from '../components/texture/ReasoningLines.astro';
import Photo from '../components/photo/Photo.astro';
import PhotoCluster from '../components/photo/PhotoCluster.astro';
import PhotoRow from '../components/photo/PhotoRow.astro';
import { PHOTO_DISCLOSURE, PHOTO_DISCLOSURE_SHORT } from '../lib/photography/library';

// About VAI — institutional page. Deliberately not founder- or Academy-centred: it states what VAI is, why it exists, how its capabilities
// connect, what it is built around and where it is going. Built against the same --brand-* tokens, spacing tiers (sec-*) and texture system
// as the homepage (see the TEXTURE SYSTEM block in src/styles/global.css); texture is used on five sections only, the rest are left at rest.
//
// Photography: illustrative imagery of the profession (src/lib/photography/library.ts, PHOTOGRAPHY SYSTEM block in global.css), used for exactly
// three restrained moments: one editorial cluster after the opening, a two-image breadth row, and one Academy image (a generated placeholder until a
// real Trusted Vet Method photograph replaces it). Hero, Why VAI, Platform, How we build, Pulse, Direction and the closing CTA carry no photography.
// The people shown are never presented as VAI faculty, team or members; the disclosure accompanies the cluster.
//
// Tense rule: Ask VAI, Practice and VAI Pulse are described as they exist today; Learn / Academy-connected development and the closing
// "direction" are written as direction, never as available functionality. No partnerships, faculty, validation, numbers or regulatory
// status are claimed.
const OPEN_VAI_URL = 'https://app.vai.vet';
const ACADEMY_URL = '/academy/'; // temporary: in-site Academy presentation until the full learning environment is ready

const platform = [
  {
    word: 'Evidence',
    label: 'The evidence layer',
    body: 'Current veterinary science and trusted professional knowledge form the evidence layer supporting the platform.',
    pulse: true,
  },
  {
    word: 'Reason',
    label: 'Ask VAI',
    body: 'Ask VAI is being developed to support evidence-aware clinical reasoning while making uncertainty and evidence limitations visible.',
  },
  {
    word: 'Practise',
    label: 'VAI Practice',
    body: 'VAI Practice provides a place to rehearse clinical reasoning and difficult professional conversations through realistic scenarios.',
  },
  {
    word: 'Develop',
    label: 'VAI Veterinary Academy and learning',
    body: 'VAI Veterinary Academy and VAI’s developing learning capabilities connect education with the skills professionals use in real clinical work.',
  },
];

const principles = [
  { t: 'Evidence before assertion', d: 'Clinical statements should be traceable to appropriate sources, with limitations made visible rather than hidden.' },
  { t: 'Uncertainty made explicit', d: 'When evidence does not support a conclusion, the platform should say so.' },
  { t: 'Professional judgement remains human', d: 'VAI is intended to support veterinary professionals, not replace their clinical responsibility.' },
  { t: 'Practice should connect to development', d: 'Reasoning, communication, learning and assessment should reinforce one another rather than exist as disconnected tools.' },
  { t: 'Privacy by design', d: 'Professional activity and case information should be handled with clear controls, consent and respect for professional confidentiality.' },
];

const breadth = ['Across species', 'Across disciplines', 'Across professional settings'];
---
<Base
  title="About VAI"
  description="VAI is building a professional platform for veterinary medicine, bringing together scientific knowledge, clinical reasoning, deliberate practice and professional development in one connected environment."
>
  <!-- 1. Hero -->
  <section class="tx-host bg-[var(--brand-midnight-navy)] text-[var(--brand-cloud-white)]">
    <SignatureGeometry tone="navy" place="hero" />
    <div class="tx-content mx-auto max-w-6xl px-6 sec-hero">
      <div class="max-w-4xl">
        <div class="eyebrow-brand mb-5" style="color: var(--brand-gold);">About VAI</div>
        <h1 class="font-brand-serif text-[var(--brand-cloud-white)] text-4xl md:text-6xl leading-[1.08] mb-7">
          Built around how veterinary professionals think, practise and develop.
        </h1>
        <p class="text-lg md:text-xl leading-relaxed opacity-90 max-w-2xl">
          VAI is building a professional platform for veterinary medicine &mdash; bringing together scientific knowledge, clinical reasoning, deliberate practice and professional development in one connected environment.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Why VAI exists — at rest (no texture) -->
  <section class="bg-[var(--brand-cloud-white)]">
    <div class="mx-auto max-w-6xl px-6 sec-feature">
      <div class="grid md:grid-cols-12 gap-6 md:gap-14">
        <div class="md:col-span-6">
          <div class="eyebrow-brand mb-4">Why VAI</div>
          <h2 class="font-brand-serif text-[var(--brand-midnight-navy)] text-3xl md:text-4xl leading-[1.15]">
            Veterinary knowledge is growing. The challenge is turning it into better professional judgement.
          </h2>
        </div>
        <div class="md:col-span-6 md:pt-9">
          <p class="text-[var(--brand-midnight-navy)] opacity-80 leading-relaxed mb-5">
            Veterinary professionals work in an environment of expanding scientific literature, complex clinical decisions, difficult client conversations and continuous expectations to remain current.
          </p>
          <p class="font-brand-serif text-[var(--brand-midnight-navy)] text-2xl leading-snug mb-5">Knowledge alone is not enough.</p>
          <p class="text-[var(--brand-midnight-navy)] opacity-80 leading-relaxed">
            VAI is being built to help connect evidence with reasoning, reasoning with practice, and practice with continued professional development.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2b. First photographic moment — one asymmetric editorial cluster: the people and environments of veterinary medicine -->
  <section class="bg-[var(--brand-cloud-white)]" aria-label="The veterinary profession">
    <div class="mx-auto max-w-6xl px-6 pb-10 md:pb-14">
      <PhotoCluster
        lead="imaging-teaching-scrubs"
        second="vet-with-dog-classroom"
        third="surgeon-mentor-team"
        caption={PHOTO_DISCLOSURE}
      />
    </div>
  </section>

  <!-- 3. The platform — one connected environment, shown as a single thread rather than four feature cards -->
  <section class="tx-host bg-white border-t border-black/10">
    <ReasoningLines variant="flow" tone="light" place="flow" />
    <div class="tx-content mx-auto max-w-6xl px-6 sec-feature">
      <div class="max-w-3xl mb-8 md:mb-10">
        <div class="eyebrow-brand mb-4">The platform</div>
        <h2 class="font-brand-serif text-[var(--brand-midnight-navy)] text-3xl md:text-4xl leading-[1.15]">From evidence to capability.</h2>
      </div>

      <ol class="relative pl-7 md:pl-10">
        <span class="absolute left-[3px] top-5 bottom-5 w-px bg-[var(--brand-clinical-blue)] opacity-25" aria-hidden="true"></span>
        {platform.map((p) => (
          <li class="relative grid md:grid-cols-12 gap-x-12 gap-y-2 py-5 md:py-6 border-t border-black/10 first:border-t-0">
            <span class="absolute -left-7 md:-left-10 top-[2.05rem] md:top-[2.3rem] w-[7px] h-[7px] rounded-full border border-[var(--brand-gold)] bg-white" aria-hidden="true"></span>
            <div class="md:col-span-4">
              <div class="font-brand-serif text-[var(--brand-midnight-navy)] text-3xl md:text-4xl leading-none mb-2">{p.word}</div>
              <div class="eyebrow-brand">{p.label}</div>
            </div>
            <div class="md:col-span-8 md:pt-1">
              <p class="text-[var(--brand-midnight-navy)] opacity-80 leading-relaxed max-w-xl">{p.body}</p>
              {p.pulse && (
                <p class="text-[var(--brand-midnight-navy)] opacity-80 leading-relaxed max-w-xl mt-3">
                  <a href="/pulse/" class="text-[var(--brand-clinical-blue)] underline decoration-[var(--brand-gold)] underline-offset-4 hover:opacity-70 transition-opacity">VAI Pulse</a> is the continuously updated window into recent veterinary literature.
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. Principles -->
  <section class="tx-host bg-[var(--brand-midnight-navy)] text-[var(--brand-cloud-white)]">
    <SignatureGeometry tone="navy" place="trust" />
    <div class="tx-content mx-auto max-w-6xl px-6 sec-feature">
      <div class="max-w-3xl mb-8 md:mb-10">
        <div class="eyebrow-brand mb-4" style="color: var(--brand-gold);">How we build</div>
        <h2 class="font-brand-serif text-[var(--brand-cloud-white)] text-3xl md:text-4xl leading-[1.15]">Professional trust has to be earned.</h2>
      </div>
      <ul class="border-t border-white/15 divide-y divide-white/15">
        {principles.map((p) => (
          <li class="grid md:grid-cols-12 gap-x-12 gap-y-1.5 py-5">
            <h3 class="md:col-span-5 font-brand-serif text-xl md:text-2xl leading-snug text-[var(--brand-cloud-white)]">{p.t}</h3>
            <p class="md:col-span-7 opacity-80 leading-relaxed max-w-xl">{p.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. Breadth — headline across the top; the three scopes and the explanation on the left, a deliberate photographic row on the right.
       No specialties are listed, and no image is tied to a particular label (the people shown are illustrative). -->
  <section class="bg-[var(--brand-cloud-white)]">
    <div class="mx-auto max-w-6xl px-6 sec-feature">
      <div class="max-w-3xl mb-8 md:mb-10">
        <div class="eyebrow-brand mb-4">Veterinary medicine</div>
        <h2 class="font-brand-serif text-[var(--brand-midnight-navy)] text-3xl md:text-4xl leading-[1.15]">Built for the breadth of the profession.</h2>
      </div>
      <div class="grid md:grid-cols-12 gap-8 md:gap-12 items-start">
        <div class="md:col-span-4">
          <ul class="border-t border-black/10 divide-y divide-black/10 mb-6">
            {breadth.map((b) => (
              <li class="py-3 font-brand-serif text-[var(--brand-midnight-navy)] text-2xl">{b}</li>
            ))}
          </ul>
          <p class="text-[var(--brand-midnight-navy)] opacity-80 leading-relaxed mb-4">
            VAI Veterinary is being developed with veterinary medicine as its long-term scope &mdash; across species, disciplines and professional settings.
          </p>
          <p class="text-[var(--brand-midnight-navy)] opacity-80 leading-relaxed">
            Its initial capabilities are deliberately being built and validated in focused clinical areas before broader expansion.
          </p>
        </div>
        <div class="md:col-span-8">
          {/* One clinical photograph, given the whole column: the people shown illustrate professional practice, they do not stand for the profession.
              Species, disciplines and settings are carried by the typography on the left, and can be joined by deliberately chosen imagery later. */}
          <PhotoRow
            items={[{ id: 'surgeon-theatre', ratio: 'landscape', m: 'full', mOrder: 0 }]}
            caption={PHOTO_DISCLOSURE_SHORT}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Continuously current — VAI Pulse: no photography; the literature and its own network motif are the visual subject -->
  <section class="tx-host bg-white border-t border-black/10">
    <ReasoningLines variant="network" tone="light" place="pulse" />
    <div class="tx-content mx-auto max-w-6xl px-6 sec-standard">
      <div class="max-w-2xl">
        <div class="eyebrow-brand mb-4">Continuously current</div>
        <h2 class="font-brand-serif text-[var(--brand-midnight-navy)] text-3xl md:text-4xl leading-[1.15] mb-6">The evidence keeps moving. VAI should too.</h2>
        <p class="text-[var(--brand-midnight-navy)] opacity-80 leading-relaxed mb-4">
          Veterinary literature changes continuously. VAI Pulse provides a live view of newly indexed veterinary research and professional guidance, while VAI&rsquo;s evidence systems are being developed to support carefully sourced clinical reasoning.
        </p>
        <p class="text-[var(--brand-midnight-navy)] opacity-80 leading-relaxed mb-7">
          The two are separate: Pulse is a discovery tool, and the papers it lists have not been reviewed or endorsed by VAI.
        </p>
        <a href="/pulse/" class="text-sm uppercase tracking-[0.08em] text-[var(--brand-clinical-blue)] hover:opacity-70 transition-opacity">Explore VAI Pulse &rarr;</a>
      </div>
    </div>
  </section>

  <!-- 7. Education — teaching and discussion -->
  <section class="bg-[var(--brand-cloud-white)] border-t border-black/10">
    <div class="mx-auto max-w-6xl px-6 sec-standard">
      <div class="grid md:grid-cols-12 gap-8 md:gap-12 items-center">
        <div class="md:col-span-6">
          <div class="eyebrow-brand mb-4">VAI Veterinary Academy</div>
          <h2 class="font-brand-serif text-[var(--brand-midnight-navy)] text-3xl md:text-4xl leading-[1.15] mb-6">Education connected to professional practice.</h2>
          <p class="text-[var(--brand-midnight-navy)] opacity-80 leading-relaxed mb-4">
            VAI Veterinary Academy is the educational arm of VAI Veterinary, focused on structured professional development, case-based learning and expert-led education.
          </p>
          <p class="text-[var(--brand-midnight-navy)] opacity-80 leading-relaxed mb-7">
            It is one part of the wider VAI platform, not the whole of it.
          </p>
          <a href={ACADEMY_URL} class="text-sm uppercase tracking-[0.08em] text-[var(--brand-clinical-blue)] hover:opacity-70 transition-opacity">Explore VAI Academy &rarr;</a>
        </div>
        <figure class="md:col-span-6">
          <Photo id="seminar-discussion" ratio="landscape" sizes="(min-width: 768px) 46vw, 92vw" />
          <figcaption class="ph-caption">{PHOTO_DISCLOSURE_SHORT}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 8. Direction — future-facing -->
  <section class="tx-host bg-white border-t border-black/10">
    <ReasoningLines variant="converge" tone="light" place="ask" />
    <div class="tx-content mx-auto max-w-6xl px-6 sec-standard">
      <div class="max-w-2xl">
        <div class="eyebrow-brand mb-4">Where we are going</div>
        <h2 class="font-brand-serif text-[var(--brand-midnight-navy)] text-3xl md:text-4xl leading-[1.15] mb-6">A professional system that learns where development is needed.</h2>
        <p class="text-[var(--brand-midnight-navy)] opacity-80 leading-relaxed mb-4">
          VAI&rsquo;s longer-term direction is to connect evidence, reasoning, practice, assessment and education so that professional development can become more relevant to the individual clinician.
        </p>
        <p class="text-[var(--brand-midnight-navy)] opacity-80 leading-relaxed">
          The aim is not simply to provide more information, but to help turn trusted knowledge into practical professional capability.
        </p>
      </div>
    </div>
  </section>

  <!-- 9. Final CTA -->
  <section class="tx-host bg-[var(--brand-cloud-white)] border-t border-black/10">
    <SignatureGeometry tone="light" place="cta" />
    <div class="tx-content mx-auto max-w-6xl px-6 sec-standard text-center">
      <h2 class="font-brand-serif text-[var(--brand-midnight-navy)] text-3xl md:text-4xl leading-[1.15] max-w-2xl mx-auto mb-10">
        Bring the case that&rsquo;s on your mind.
      </h2>
      <a href={OPEN_VAI_URL} rel="noopener noreferrer" class="btn-brand btn-brand-primary">Open VAI</a>
    </div>
  </section>
</Base>

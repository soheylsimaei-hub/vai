---
// VAI PHOTO STREAM — two offset rows of editorial photographs drifting slowly in opposite directions (>= 768px), and an intentional static
// two-column mosaic below that. CSS-only motion (no JavaScript); pauses on hover; fully static under prefers-reduced-motion.
//
// Accessibility: the people are illustrations of the profession, so every image is decorative (alt=""); the figcaption carries the meaning and the
// disclosure. Only the first of three copies of each row is exposed to assistive technology (copies exist solely so the loop is seamless).
// Performance: all images lazy; the three copies reuse the same URLs, so each file is fetched once.
import Photo from './Photo.astro';
import { PHOTO_DISCLOSURE } from '../../lib/photography/library';

type Item = { id: string; ratio: 'portrait' | 'landscape' };
interface Props {
  rowA: Item[];
  rowB: Item[];
  /** Two columns of {id, ratio: portrait|square} for < 768px. */
  mobile: [Array<{ id: string; ratio: 'portrait' | 'square' }>, Array<{ id: string; ratio: 'portrait' | 'square' }>];
  caption?: string;
}
const { rowA, rowB, mobile, caption = 'The people, knowledge and environments of veterinary medicine.' } = Astro.props;
const rows = [
  { key: 'a', items: rowA },
  { key: 'b', items: rowB },
];
const sizesFor = (r: string) => (r === 'portrait' ? 'max(144px, min(14vw, 272px))' : 'max(270px, min(25.5vw, 510px))');
---
<figure class="ph-stream">
  <div class="ph-stream-desktop hidden md:block">
    <div class="ph-rows">
      {rows.map((row) => (
        <div class={`ph-row ph-row--${row.key}`}>
          <div class="ph-track">
            {[0, 1, 2].map((copy) => (
              <div class="ph-set" data-dup={copy > 0 ? 'true' : undefined} aria-hidden={copy > 0 ? 'true' : undefined}>
                {row.items.map((it) => (
                  <div class={`ph-item ph-item--${it.ratio}`}>
                    <Photo id={it.id} ratio="fill" decorative sizes={sizesFor(it.ratio)} />
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="ph-stream-mobile md:hidden">
    {mobile.map((col, i) => (
      <div class={`ph-mcol ${i === 1 ? 'ph-mcol--offset' : ''}`}>
        {col.map((it) => (
          <Photo id={it.id} ratio={it.ratio} decorative sizes="45vw" />
        ))}
      </div>
    ))}
  </div>

  <figcaption class="ph-caption mx-auto max-w-6xl px-6">
    {caption} <span class="ph-disclosure">{PHOTO_DISCLOSURE}</span>
  </figcaption>
</figure>

---
// The VAI contact form. It posts (JSON, from the browser) to the VAI app's public contact endpoint, which emails the enquiry to vai@vai.vet, or to faculty@vai.vet for Faculty Collaboration, with the enquirer as
// Reply-To. It stores nothing. If the message cannot be delivered the visitor is told so plainly and given the two addresses; the form never reports "sent" unless the server confirms it.
// Protections: required fields and an explicit consent checkbox, a hidden honeypot field, a fill-time trap (the render time is sent), and the server-side origin allow-list, validation and rate limit.
const ENDPOINT = 'https://app.vai.vet/api/public-contact';

const CATEGORIES = ['General Enquiry', 'VAI Platform', 'VAI Veterinary Academy', 'Faculty Collaboration', 'Partnerships & Organisations', 'Other'];

// Programme of interest can be pre-selected via ?programme=trusted-vet-method
const programmeParam = Astro.url.searchParams.get('programme') ?? '';
const programmeMap: Record<string, string> = {
  'trusted-vet-method': 'The Trusted Vet Method',
  'veterinary-longevity': 'Veterinary Longevity',
  'foundations-veterinary-longevity': 'Foundations of Veterinary Longevity',
};
const programmeOfInterest = programmeMap[programmeParam] ?? '';
const isProgrammeEnquiry = programmeOfInterest !== '';
const defaultCategory = isProgrammeEnquiry ? 'VAI Veterinary Academy' : 'General Enquiry';
const field = 'w-full border border-platinum bg-paper px-4 py-3 text-graphite font-sans focus:outline-none focus:border-navy';
---
<div id="contact-root" data-endpoint={ENDPOINT}>
  <form id="contact-form" class="max-w-3xl mx-auto grid gap-6" novalidate>
    <div>
      <label class="eyebrow mb-2 block" for="enquiry-type">Enquiry type</label>
      <select id="enquiry-type" name="category" required class={field}>
        {CATEGORIES.map((c) => <option value={c} selected={c === defaultCategory}>{c}</option>)}
      </select>
    </div>

    {isProgrammeEnquiry && (
      <div>
        <label class="eyebrow mb-2 block" for="programme">Programme of interest</label>
        <input id="programme" name="programme" type="text" readonly value={programmeOfInterest} class="w-full border border-platinum bg-platinum-soft/40 px-4 py-3 text-navy-deep font-sans focus:outline-none" />
      </div>
    )}

    <div class="grid md:grid-cols-2 gap-6">
      <div>
        <label class="eyebrow mb-2 block" for="name">Name</label>
        <input id="name" name="name" type="text" required maxlength="120" autocomplete="name" class={field} />
      </div>
      <div>
        <label class="eyebrow mb-2 block" for="email">Email</label>
        <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" class={field} />
      </div>
    </div>

    <div>
      <label class="eyebrow mb-2 block" for="role">Role (optional)</label>
      <input id="role" name="role" type="text" maxlength="120" placeholder="e.g. veterinarian, practice owner, educator" class={field} />
    </div>

    <div>
      <label class="eyebrow mb-2 block" for="message">Message</label>
      <textarea id="message" name="message" required rows="6" minlength="10" maxlength="5000" class={field}></textarea>
    </div>

    <!-- Honeypot: invisible to people, tempting to bots. Anything typed here means the submission is discarded. -->
    <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden">
      <label for="website">Leave this field empty</label>
      <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="grid gap-4 pt-2">
      <label class="flex items-start gap-3 text-xs text-muted leading-relaxed max-w-xl cursor-pointer">
        <input id="consent" name="consent" type="checkbox" required class="mt-0.5 h-4 w-4 shrink-0" />
        <span>I agree that VAI may use these details to respond to my enquiry. See the <a href="https://app.vai.vet/privacy" rel="noopener" class="link-ink">Privacy Policy</a>.</span>
      </label>
      <div class="flex flex-col md:flex-row md:items-center gap-4">
        <button id="contact-submit" type="submit" class="btn btn-primary">Send Enquiry</button>
        <p id="contact-status" role="status" aria-live="polite" class="text-sm leading-relaxed"></p>
      </div>
    </div>

    <noscript>
      <p class="text-sm text-graphite leading-relaxed">This form needs JavaScript. You can also write to <a class="link-ink" href="mailto:vai@vai.vet">vai@vai.vet</a>, or to <a class="link-ink" href="mailto:faculty@vai.vet">faculty@vai.vet</a> for faculty and academic collaboration.</p>
    </noscript>
  </form>

  <div id="contact-done" class="max-w-3xl mx-auto hidden" role="status" tabindex="-1">
    <div class="border-2 border-champagne bg-paper p-8 md:p-10">
      <div class="eyebrow mb-3">Message sent</div>
      <p class="font-serif text-2xl md:text-3xl text-navy-deep mb-3">Thank you.</p>
      <p class="text-graphite leading-relaxed">Your message has been sent to VAI. We will reply to the email address you provided.</p>
    </div>
  </div>
</div>

<script>
  const root = document.getElementById('contact-root') as HTMLElement | null;
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (root && form) {
    const endpoint = root.dataset.endpoint as string;
    const renderedAt = Date.now();
    const status = document.getElementById('contact-status') as HTMLElement;
    const submit = document.getElementById('contact-submit') as HTMLButtonElement;
    const done = document.getElementById('contact-done') as HTMLElement;
    const say = (html: string, tone: 'info' | 'error') => {
      status.innerHTML = html;
      status.className = 'text-sm leading-relaxed ' + (tone === 'error' ? 'text-red-800' : 'text-graphite');
    };
    const directEmail = 'Please try again, or write to <a class="link-ink" href="mailto:vai@vai.vet">vai@vai.vet</a> (or <a class="link-ink" href="mailto:faculty@vai.vet">faculty@vai.vet</a> for faculty and academic collaboration).';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submit.disabled) return; // no double submission
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') ?? ''),
        email: String(data.get('email') ?? ''),
        category: String(data.get('category') ?? ''),
        message: String(data.get('message') ?? ''),
        role: String(data.get('role') ?? ''),
        programme: String(data.get('programme') ?? ''),
        consent: (document.getElementById('consent') as HTMLInputElement).checked,
        website: String(data.get('website') ?? ''),
        t: renderedAt,
      };
      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      submit.textContent = 'Sending…';
      say('Sending your message…', 'info');
      try {
        const res = await fetch(endpoint, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
        const body = await res.json().catch(() => ({}) as { ok?: boolean; error?: string });
        if (res.ok && body.ok === true) {
          form.classList.add('hidden');
          done.classList.remove('hidden');
          done.focus();
          return;
        }
        const reason = typeof body.error === 'string' && res.status < 500 ? body.error + ' ' : 'We could not send your message just now. ';
        say(reason + directEmail, 'error');
      } catch {
        say('We could not send your message just now. ' + directEmail, 'error');
      }
      submit.disabled = false;
      submit.removeAttribute('aria-busy');
      submit.textContent = 'Send Enquiry';
    });
  }
</script>

---
// Phase 4A.2A correction — Ask VAI removed from the public header per
// founder instruction: vai.vet = understand/discover/evaluate VAI,
// app.vai.vet = use VAI, and Open VAI is the single primary transition
// between the two. Ask VAI keeps its full homepage section; it just isn't
// a header shortcut into the app anymore.
//
// Phase 4A.4 — Practice and Learn removed from the header too: they
// pointed at public /practice and /learn routes that don't exist in this
// repo yet (both 404'd). Zero-broken-links takes priority over completeness
// here — both come back once those pages (or a different destination
// decision) exist. Their homepage sections are unaffected and unchanged.
//
// Phase 4A.6B — Academy restored to the header as a real, active link.
//
// Phase 4A.13 — academy.vai.vet is now live as a real standalone
// deployment (the VAI Academy LMS). Academy nav item repointed from the
// interim /academy in-site page to the real subdomain.
//
// "For Organisations" has no standalone page yet and building one is out of
// scope for this phase, so it points at the #for-organisations section on
// the homepage rather than a 404.
const NAV_LINKS = [
  { href: 'https://academy.vai.vet/', label: 'Academy', external: true },
  { href: '/#for-organisations', label: 'For Organisations' },
  { href: '/about', label: 'About' },
];
const OPEN_VAI_URL = 'https://app.vai.vet';
---
<header class="border-b border-black/10 bg-[var(--brand-cloud-white)]">
  <div class="mx-auto max-w-6xl px-4 py-5 md:py-6 flex items-center justify-between gap-4 md:gap-4">
    <a href="/" class="shrink-0" aria-label="VAI Veterinary — Home">
      <picture>
        <source srcset="/vai-veterinary-lockup.webp" type="image/webp" />
        <!-- lg (desktop) width matches the VISIBLE VAI mark's prominence,
             not the whole image box. This asset has ~46% transparent
             padding baked into its canvas (the "VAI" wordmark + separator
             + "VETERINARY" text occupy roughly the middle 54%x40% of a
             1600x480 canvas) — an equal image-box height (previously
             lg:w-[344px], a 103px box) rendered the actual blue/gold "VAI"
             mark at only ~42px tall, well short of Academy's own ~83px
             mark at its own desktop box. 682px is the width that makes
             this asset's visible mark ~83px tall, pixel-measured against
             both assets' alpha channels — see the logo-audit report for
             the derivation. The wider "VETERINARY" text this drags along
             is expected and accepted (the reference brief explicitly
             allows it). Base/sm/md are left at their existing, already-
             compact values — Academy and app.vai.vet are likewise compact
             below their own desktop tier, so there's no case for growing
             this site's logo there too. -->
        <img
          src="/vai-veterinary-lockup.png"
          alt="VAI Veterinary"
          width="1600"
          height="480"
          class="w-[150px] sm:w-[170px] md:w-[190px] lg:w-[682px] h-auto"
        />
      </picture>
    </a>

    <nav class="hidden md:flex items-center gap-5 lg:gap-5 flex-1 justify-end mr-2 lg:mr-0">
      {NAV_LINKS.map((l) => (
        <a
          href={l.href}
          rel={l.external ? 'noopener noreferrer' : undefined}
          class="text-sm uppercase tracking-[0.08em] whitespace-nowrap font-medium text-[var(--brand-midnight-navy)] hover:text-[var(--brand-clinical-blue)] transition-colors"
        >{l.label}</a>
      ))}
    </nav>

    <a href={OPEN_VAI_URL} rel="noopener noreferrer" class="hidden md:inline-flex btn-brand btn-brand-primary shrink-0">Open VAI</a>

    <button id="nav-toggle" class="md:hidden text-[var(--brand-midnight-navy)] text-xs tracking-[0.18em] uppercase" aria-label="Menu">Menu</button>
  </div>

  <!-- Mobile menu -->
  <div id="nav-mobile" class="hidden md:hidden border-t border-black/10">
    <nav class="mx-auto max-w-6xl px-6 flex flex-col gap-4 py-6 text-sm tracking-[0.08em] uppercase">
      {NAV_LINKS.map((l) => (
        <a href={l.href} rel={l.external ? 'noopener noreferrer' : undefined} class="font-medium text-[var(--brand-midnight-navy)]">{l.label}</a>
      ))}
      <a href={OPEN_VAI_URL} rel="noopener noreferrer" class="btn-brand btn-brand-primary mt-2 justify-center">Open VAI</a>
    </nav>
  </div>
</header>
<script>
  const t = document.getElementById('nav-toggle');
  const m = document.getElementById('nav-mobile');
  t?.addEventListener('click', () => m?.classList.toggle('hidden'));
</script>

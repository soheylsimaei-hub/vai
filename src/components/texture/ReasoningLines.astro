---
// REASONING LINES (secondary motif). Three restrained variants of fine lines and sparse nodes:
//   flow     long crossing lines behind Reason / Practise / Develop (atmosphere, not a diagram)
//   network  VAI Pulse: sparse evidence nodes, fine links and a faint drift toward VAI (living knowledge, not monitoring equipment)
//   converge Ask VAI: many faint evidence paths blending into fewer and one conclusion (streamlines, deliberately NOT a decision tree)
// Purely decorative: aria-hidden, pointer-events none.
interface Props { tone?: 'light' | 'navy'; place: string; variant?: keyof typeof ART; }
const { tone = 'light', place, variant = 'flow' } = Astro.props;
const ART = {
  flow: `<svg viewBox="0 0 1440 420" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><path class="s2" d="M-60 270 C190 90 430 340 660 215 S1040 120 1500 200"/><path class="s" d="M-60 340 C250 260 470 372 700 292 S1090 262 1500 124"/><path class="s dense" d="M300 196 L352 140"/><path class="s dense" d="M786 252 L842 316"/><path class="s dense" d="M1052 156 L1110 98"/><path class="s dense" d="M520 306 L566 360"/><circle class="s2" cx="352" cy="140" r="4.5"/><circle class="s2" cx="842" cy="316" r="4"/><circle class="s2" cx="1110" cy="98" r="4.5"/><circle class="nd" cx="300" cy="196" r="2"/><circle class="nd" cx="786" cy="252" r="2"/><circle class="nd" cx="1052" cy="156" r="2"/><circle class="nd" cx="566" cy="360" r="2.2"/><circle class="nd" cx="520" cy="306" r="1.6"/></svg>`,

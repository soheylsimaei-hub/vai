  converge: `<svg viewBox="0 0 900 700" preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><path class="s" d="M960 30 C750 30 902.4 230.4 873.1 237"/><path class="s dense" d="M960 118 C750 118 873.4 232.4 776.5 263.5"/><path class="s" d="M960 214 C750 214 788 257.4 684.9 295.9"/><path class="s dense" d="M960 332 C750 332 721.1 288.8 606.2 323.4"/><path class="s" d="M960 432 C750 432 655.6 312.6 558.4 336"/><path class="s dense" d="M960 526 C750 526 597 332.5 488.4 350.3"/><path class="s" d="M960 648 C750 648 542.9 349.7 413.2 359.2"/><path class="s2" d="M330 362 C430 362 500 352 590 328 C680 304 770 252 940 224"/><path class="g" d="M330 362 L262 362"/><circle class="s2" cx="330" cy="362" r="6.5"/><circle class="nd" cx="330" cy="362" r="2.4"/></svg>`,
